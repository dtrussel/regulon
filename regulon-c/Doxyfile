# Doxygen configuration for the Regulon C11 API.
#
# Doxygen is only the XML backend for the Sphinx + Breathe site: docs/conf.py
# runs it from this directory and reads doxygen_output/xml. Only settings that
# differ from Doxygen's defaults are listed; `doxygen -x Doxyfile` shows the
# same diff.
#
# SPDX-License-Identifier: MIT

PROJECT_NAME           = Regulon
PROJECT_BRIEF          = "C11 Control Systems Library"
OUTPUT_DIRECTORY       = doxygen_output
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
SORT_MEMBER_DOCS       = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
INPUT                  = include/ron
FILE_PATTERNS          = *.h
INPUT_FILTER           = scripts/doxygen_filter.py
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "RON_STATIC_ASSERT(cond,msg)="
HAVE_DOT               = NO
