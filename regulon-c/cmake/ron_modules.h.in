/*
 * @file     ron_modules.h
 * @brief    Build-time module-availability configuration (generated by CMake).
 * @module   ron_modules
 * @doc      RON-IS-001
 * @req      RON-DC-001
 * @version  1.0.0
 * SPDX-License-Identifier: MIT
 *
 * This header is generated from cmake/ron_modules.h.in by configure_file().  It
 * records which optional modules were enabled when the library was built so that
 * the aggregate header ron/ron.h (and any consumer) can include only the headers
 * whose implementations are present.  Each RON_HAVE_<MODULE> macro is 1 when the
 * module is built into the library and 0 otherwise.
 *
 * The PID core and its integrated feed-forward path are the mandatory baseline
 * and are therefore always available (RON_HAVE_PID / RON_HAVE_FEEDFORWARD == 1).
 *
 * Do not edit this file directly; edit cmake/ron_modules.h.in instead.  This
 * header is distinct from the optional user-supplied ron_config.h platform
 * override referenced by ron_platform.h.
 */

#ifndef RON_MODULES_H
#define RON_MODULES_H

/* Mandatory baseline — always present. */
#define RON_HAVE_PID         1
#define RON_HAVE_FEEDFORWARD 1

/* Optional modules (1 = built, 0 = excluded). */
#define RON_HAVE_FILTER     @RON_HAVE_FILTER@
#define RON_HAVE_GAIN_SCHED @RON_HAVE_GAIN_SCHED@
#define RON_HAVE_TRAJECTORY @RON_HAVE_TRAJECTORY@
#define RON_HAVE_CASCADE    @RON_HAVE_CASCADE@
#define RON_HAVE_KALMAN     @RON_HAVE_KALMAN@
#define RON_HAVE_STATESPACE @RON_HAVE_STATESPACE@
#define RON_HAVE_AUTOTUNE   @RON_HAVE_AUTOTUNE@
#define RON_HAVE_HEALTH     @RON_HAVE_HEALTH@
#define RON_HAVE_METRICS    @RON_HAVE_METRICS@

#endif /* RON_MODULES_H */
